// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  username String  @unique
  name     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  password         Password?
  roles            Role[]
  sessions         Session[]
  connections      Connection[]
  passkey          Passkey[]
  recipes          Recipe[]
  inventoryItems   InventoryItem[]
  shoppingLists    ShoppingList[]
  householdMembers HouseholdMember[]
  householdInvites HouseholdInvite[]
  householdEvents    HouseholdEvent[]
  subscription       Subscription?
  usageEvents        UsageEvent[]
}

model Password {
  hash String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String @unique
}

model Session {
  id             String   @id @default(cuid())
  expirationDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String

  // non-unique foreign key
  @@index([userId])
}

model Permission {
  id          String @id @default(cuid())
  action      String // e.g. create, read, update, delete
  entity      String // e.g. note, user, etc.
  access      String // e.g. own or any
  description String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles Role[]

  @@unique([action, entity, access])
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  description String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  permissions Permission[]
}

model Verification {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// The type of verification, e.g. "email" or "phone"
  type String

  /// The thing we're trying to verify, e.g. a user's email or phone number
  target String

  /// The secret key used to generate the otp
  secret String

  /// The algorithm used to generate the otp
  algorithm String

  /// The number of digits in the otp
  digits Int

  /// The number of seconds the otp is valid for
  period Int

  /// The valid characters for the otp
  charSet String

  /// When it's safe to delete this verification
  expiresAt DateTime?

  @@unique([target, type])
}

model Connection {
  id           String @id @default(cuid())
  providerName String
  providerId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String

  @@unique([providerName, providerId])
}

model Passkey {
  id             String   @id
  aaguid         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  publicKey      Bytes
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  webauthnUserId String
  counter        BigInt
  deviceType     String // 'singleDevice' or 'multiDevice'
  backedUp       Boolean
  transports     String? // Stored as comma-separated values

  @@index(userId)
}

model Household {
  id   String @id @default(cuid())
  name String @default("My Household")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members           HouseholdMember[]
  invites           HouseholdInvite[]
  events            HouseholdEvent[]
  recipes           Recipe[]
  inventoryItems    InventoryItem[]
  mealPlans         MealPlan[]
  shoppingLists     ShoppingList[]
  menus             Menu[]
}

model HouseholdMember {
  id   String @id @default(cuid())
  role String @default("owner")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  @@unique([householdId, userId])
  @@index([householdId])
  @@index([userId])
}

model HouseholdInvite {
  id        String    @id @default(cuid())
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String

  @@index([householdId])
}

model Subscription {
  id                    String    @id @default(cuid())
  tier                  String    @default("free")
  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?   @unique
  subscriptionExpiresAt DateTime?
  trialEndsAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique
}

model Recipe {
  id          String   @id @default(cuid())
  title       String
  description String?
  servings    Int      @default(4)
  prepTime    Int?     // minutes
  cookTime    Int?     // minutes
  isFavorite     Boolean  @default(false)
  isAiGenerated  Boolean  @default(false)
  sourceUrl      String?
  rawText     String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  household   Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)
  householdId String?

  image           RecipeImage?
  ingredients     Ingredient[]    @relation("RecipeIngredients")
  linkedFromIngredients Ingredient[] @relation("LinkedRecipe")
  instructions    Instruction[]
  menuItems       MenuItem[]
  mealRecipeItems MealRecipeItem[]

  @@index([userId])
  @@index([householdId])
  @@index([title])
}

model RecipeImage {
  id        String   @id @default(cuid())
  altText   String?
  objectKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId String @unique
}

model Ingredient {
  id        String  @id @default(cuid())
  name      String
  amount    String? // "2", "1/2" (string for fractions)
  unit      String? // "cups", "tbsp"
  notes     String? // "diced", "room temperature"
  isHeading Boolean @default(false)
  order     Int     @default(0)

  recipe   Recipe @relation("RecipeIngredients", fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId String

  linkedRecipe   Recipe? @relation("LinkedRecipe", fields: [linkedRecipeId], references: [id], onDelete: SetNull)
  linkedRecipeId String?

  @@index([recipeId])
}

model Instruction {
  id      String @id @default(cuid())
  content String
  order   Int

  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId String

  @@index([recipeId])
}

model Menu {
  id          String  @id @default(cuid())
  title       String
  /// Trimmed, Unicode-normalized (NFKC), lower-cased title — the Menu's
  /// case-insensitive identity within its household.
  titleKey    String
  description String?
  /// Optional context for later planning; never scales quantities by itself.
  defaultGuestCount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String

  sections MenuSection[]
  meals    Meal[]

  @@unique([householdId, titleKey])
  @@index([householdId, updatedAt])
}

model MenuSection {
  id    String  @id @default(cuid())
  /// null marks the durable unnamed section every Menu starts with.
  name  String?
  order Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuId String

  items MenuItem[]

  @@index([menuId, order])
}

model MenuItem {
  id    String @id @default(cuid())
  /// Discriminator: 'recipe' or 'note'. A note card carries flexible text plus
  /// ordered Shopping lines instead of a Recipe reference.
  kind  String
  order Int    @default(0)

  /// Frozen at add/replace time so a deleted Recipe's card keeps its identity.
  recipeTitle String?
  /// Positive decimal batches of the Recipe's stored ingredient list ("1×" = one
  /// batch). Deliberately not derived from legacy servings, which has no
  /// reliability provenance (#98 readiness corrections).
  scaleMultiplier Float?
  /// A Recipe card's optional serving/preparation context — or, on a note
  /// card, the card's flexible text itself.
  note String?

  /// Nulled when the Recipe is deleted — the card then reads as missing until
  /// the user explicitly replaces or removes it.
  recipe   Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  recipeId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section   MenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId String

  shoppingLines MenuShoppingLine[]

  @@index([sectionId, order])
  @@index([recipeId])
}

/// An ordinary Shopping line carried by a note card, so supporting purchases
/// (drinks, candles, ice) travel with the Menu without a dedicated subsystem.
model MenuShoppingLine {
  id   String @id @default(cuid())
  name String
  /// Free-text amount — structured enough for later aggregation (#108) while
  /// unresolved wording stays usable.
  quantity String?
  unit     String?
  order    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item   MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId String

  @@index([itemId, order])
}

model InventoryItem {
  id        String    @id @default(cuid())
  name      String    // Free-text: "chicken breast", "Chicken Breasts"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  household   Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)
  householdId String?

  @@index([userId])
  @@index([householdId])
}

model MealPlan {
  id          String   @id @default(cuid())
  weekStart   DateTime // Monday midnight UTC
  household   Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String
  meals       Meal[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([householdId, weekStart])
}

/// One scheduled Meal within the household/week Plan — the ordered parent
/// Release 1B evolves the planner around (#104/#105). The sole Plan
/// representation since #106 contracted the legacy fixed-slot MealPlanEntry
/// rows.
model Meal {
  id   String   @id @default(cuid())
  /// Semantic date within the Plan week (midnight UTC).
  date DateTime
  /// Explicit within-day order — authoritative. Label and serving time are
  /// display metadata and never silently reorder Meals.
  order Int
  /// Optional familiar label ("breakfast", "lunch", …).
  label String?
  /// Optional serving time, stored once as a UTC instant plus the IANA
  /// timezone it was entered in. Date/time edits recompute the instant from
  /// the Plan's semantic date; Release 5 reuses this representation.
  servingAt       DateTime?
  servingTimeZone String?
  /// Generic text ("Leftovers") — mutually exclusive with Recipe items. A
  /// text-only Meal has no Shopping behavior.
  genericText String?
  /// Completion for a text-only Meal. A Recipe Meal instead derives completion
  /// from its items' cooked state; a Meal-level "mark cooked" action updates
  /// all items explicitly.
  completed  Boolean @default(false)
  /// Planning context only — never scales quantities by itself.
  guestCount Int?

  /// Where this Meal was planned from, kept for a future explicit
  /// Update-from-Menu action. revision = the Menu's updatedAt when the
  /// snapshot was taken, so later Menu edits are detectable.
  sourceMenu         Menu?     @relation(fields: [sourceMenuId], references: [id], onDelete: SetNull)
  sourceMenuId       String?
  sourceMenuRevision DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  mealPlanId String

  recipeItems MealRecipeItem[]
  sections    MealSection[]
  noteItems   MealNoteItem[]

  @@index([mealPlanId, date, order])
  @@index([sourceMenuId])
}

/// One frozen Menu section inside a Meal snapshot (#107). Copied at planning
/// time and never re-read from the Menu, so later Menu edits cannot mutate
/// the planned event. Planner-created Meals have no sections.
model MealSection {
  id    String  @id @default(cuid())
  /// null marks the snapshot of a Menu's durable unnamed section.
  name  String?
  order Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
  mealId String

  recipeItems MealRecipeItem[]
  noteItems   MealNoteItem[]

  @@index([mealId, order])
}

/// A note card frozen into a Meal snapshot — drinks, shared prep, serving
/// reminders — with its ordinary Shopping lines underneath. Shares its
/// section's order sequence with MealRecipeItem, like MenuItem's two kinds.
model MealNoteItem {
  id    String @id @default(cuid())
  order Int
  text  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
  mealId String

  /// Snapshot notes always sit in a section; SetNull mirrors the Menu rule
  /// that structural cleanup never deletes content.
  section   MealSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  sectionId String?

  shoppingLines MealShoppingLine[]

  @@index([mealId, order])
  @@index([sectionId])
}

/// A note card's frozen ordinary Shopping line (#107) — the Meal-side twin of
/// MenuShoppingLine. Distinct from the current-state Shopping contribution
/// records #108 introduces.
model MealShoppingLine {
  id       String  @id @default(cuid())
  name     String
  quantity String?
  unit     String?
  order    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  noteItem   MealNoteItem @relation(fields: [noteItemId], references: [id], onDelete: Cascade)
  noteItemId String

  @@index([noteItemId, order])
}

/// One ordered Recipe card inside a Meal. Cooked state lives here, not on the
/// Meal (#98 readiness corrections).
model MealRecipeItem {
  id    String @id @default(cuid())
  order Int
  /// Frozen at add/replace time so a deleted Recipe's card keeps its identity.
  recipeTitle String
  /// Positive decimal batches of the Recipe's stored ingredient list ("1×" =
  /// one batch). Migrated legacy serving overrides become
  /// override / Recipe.servings — preserving the chosen ratio without
  /// treating legacy servings as trustworthy yield (#98).
  scaleMultiplier Float   @default(1)
  cooked          Boolean @default(false)
  /// Frozen display note copied from the Menu card at planning time (#107).
  note            String?

  /// Nulled when the Recipe is deleted — the card then reads as missing until
  /// the user explicitly replaces or removes it.
  recipe   Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  recipeId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
  mealId String

  /// Set on Menu-snapshot items (#107); planner-created items stay unsectioned
  /// and `order` then sequences within the Meal instead of within a section.
  section   MealSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  sectionId String?

  @@index([mealId, order])
  @@index([recipeId])
  @@index([sectionId])
}

model ShoppingList {
  id          String   @id @default(cuid())
  name        String   @default("Shopping List")
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  household   Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)
  householdId String? @unique
  items       ShoppingListItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model ShoppingListItem {
  id         String   @id @default(cuid())
  name       String
  quantity   String?  // Freeform: "2", "1/2 cup", etc.
  unit       String?
  category   String?  // "produce", "dairy", "meat", "pantry", "frozen", "bakery", "household", "other"
  checked    Boolean  @default(false)
  source     String   @default("manual") // "manual", "generated", "recipe", or "discover"
  listId     String
  list       ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([listId])
  @@index([listId, checked])
}

model HouseholdEvent {
  id        String   @id @default(cuid())
  type      String
  payload   String   // JSON string
  createdAt DateTime @default(now())

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  @@index([householdId, createdAt])
  @@index([householdId, userId])
  @@index([householdId, type, createdAt])
}

model UsageEvent {
  id        String   @id @default(cuid())
  type      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@index([type, createdAt])
  @@index([userId, createdAt])
}
