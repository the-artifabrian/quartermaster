LITEFS_DIR="/litefs/data"
DATABASE_PATH="./prisma/data.db"
DATABASE_URL="file:./prisma/data.db"
DATA_VOLUME_PATH="./prisma"
# Signs session and other cookies. This value is for local use only. For a real
# deploy, generate one with `openssl rand -hex 32`. A comma-separated list
# rotates secrets: the first signs, all of them verify.
SESSION_SECRET="local-development-only"
# The origin for every absolute URL the app hands out; docs/ARCHITECTURE.md
# lists what uses it. Required in production (https://useqm.app). Leave it
# empty in dev and tests, where it defaults to http://localhost:$PORT.
APP_ORIGIN=""
# Required in production (boot refuses to start without it unless MOCKS="true").
# Tests send email through tests/mocks/resend.ts, which takes any key, so keep
# this placeholder. Empty, `bun run dev:no-mocks` logs each email instead.
RESEND_API_KEY="re_local_placeholder"
# Optional: email provider request timeout in whole milliseconds (default 10000).
# Leave unset or empty for the default; a non-numeric value fails the boot.
RESEND_TIMEOUT_MS=""
POSTHOG_API_KEY=""
POSTHOG_HOST="https://eu.i.posthog.com"

# Set to "false" to ask search engines not to index the site.
ALLOW_INDEXING="true"

# iOS shell (optional). Apple Developer Team ID; leave empty and
# /.well-known/apple-app-site-association is a 404. IOS_BUNDLE_ID defaults to
# app.useqm.ios.
APPLE_TEAM_ID=""
IOS_BUNDLE_ID=""

# Tigris object storage (S3-compatible). These mock values work wherever
# MOCKS="true" (`bun run dev`, the Playwright server) and in Vitest, where
# tests/mocks/tigris.ts answers the requests.
AWS_ACCESS_KEY_ID="mock-access-key"
AWS_SECRET_ACCESS_KEY="mock-secret-key"
AWS_REGION="auto"
AWS_ENDPOINT_URL_S3="https://fly.storage.tigris.dev"
BUCKET_NAME="mock-bucket"

# Anthropic API (optional). Powers AI Recipe import and enhancement.
ANTHROPIC_API_KEY=""

# Groq API (optional). Powers voice-to-text through Whisper.
GROQ_API_KEY=""

# Stripe (optional). The app runs without it.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_YEARLY_PRICE_ID=""
