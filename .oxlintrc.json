{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"extends": ["./node_modules/@epic-web/config/oxlint-config.json"],
	"ignorePatterns": [
		"**/.cache/**",
		"**/node_modules/**",
		"**/build/**",
		"**/public/**",
		"**/*.json",
		"**/playwright-report/**",
		"**/coverage/**",
		"**/*.tsbuildinfo",
		"**/.react-router/**",
		"**/app/generated/**"
	],
	"rules": {
		"react-hooks/rules-of-hooks": "error",
		// Render-time ref reads, mostly measuring and gesture state; each needs
		// its own look before it changes.
		"react/refs": "off",
		// Effects that sync state from props or the browser; each needs its own
		// look before it changes.
		"react/set-state-in-effect": "off",
		"vitest/expect-expect": [
			"error",
			// These test helpers assert too.
			{
				"assertFunctionNames": [
					"expect",
					"assert",
					"assertType",
					"expectSelected",
					"expectLinkOnAppOrigin",
					"expectRelativeVerifyRedirect",
					"startWithPassword"
				]
			}
		],
		"vitest/no-conditional-expect": "error",
		// The inferred types of vi.fn() are checked by tsc already.
		"vitest/require-mock-type-parameters": "off",
		// These tests check that a call fails, and several of the errors come
		// from libraries whose wording isn't ours to pin.
		"vitest/require-to-throw-message": "off"
	},
	"overrides": [
		{
			"files": ["**/tests/**/*.ts"],
			"rules": {
				"react-hooks/rules-of-hooks": "off"
			}
		},
		{
			// Both install the MSW mocks: the server in mocks mode, and the
			// development seed, which uploads the demo template's photos.
			"files": ["./index.ts", "./prisma/seed.ts"],
			"rules": {
				"eslint/no-restricted-imports": "off"
			}
		},
		{
			// Redirects go through app/utils/safe-redirect.ts, which refuses
			// more than the library does. The test-file pattern is the one
			// @epic-web/config sets, repeated because this replaces it.
			"files": ["app/**/*.ts", "app/**/*.tsx"],
			"rules": {
				"eslint/no-restricted-imports": [
					"error",
					{
						"paths": [
							{
								"name": "remix-utils/safe-redirect",
								"message": "Use safeRedirect from #app/utils/safe-redirect.ts."
							}
						],
						"patterns": [
							{
								"group": [
									"**/tests/**",
									"**/#tests/**",
									"**/__tests__/**/*",
									"**/*.test.*",
									"**/*.spec.*"
								],
								"message": "Do not import test files in source files"
							}
						]
					}
				]
			}
		},
		{
			"files": ["app/utils/safe-redirect.ts", "app/**/*.test.*"],
			"rules": {
				"eslint/no-restricted-imports": "off"
			}
		}
	]
}
